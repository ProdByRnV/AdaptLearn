APP_ENV=development
FRONTEND_URL=http://localhost:5173

# PostgreSQL (matches docker-compose defaults)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/adaptlearn

# Neo4j (matches docker-compose defaults)
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# Auth - generate a real secret, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=replace_me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Groq LLM - leave the key empty to use the fallback question bank
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Only for reasoning models such as gpt-oss (low/medium/high); leave empty for other models
GROQ_REASONING_EFFORT=low

QUIZ_SESSION_TTL_MINUTES=30
